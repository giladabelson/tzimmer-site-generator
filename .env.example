# All optional. Set per build by the npm scripts; listed here for reference.
PROPERTY_SLUG=        # which properties/<slug>/ to build
PROPERTY_ACCENT=      # override the accent colour, e.g. #6b7f4f
SITE_URL=             # canonical URL, defaults to https://<slug>.pages.dev
# Cloudflare deploys use `npx wrangler login` (no token in the repo).
