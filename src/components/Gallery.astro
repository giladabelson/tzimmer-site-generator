---
import Figure from './Figure.astro';
const { images, asWalkthrough = false } = Astro.props;
---

<section id="gallery" aria-labelledby="gal-h">
  <div class="wrap">
    <div class="sec-head" data-sc-in>
      <h2 id="gal-h">{asWalkthrough ? 'לעבור בין התמונות' : 'מבט מבפנים'}</h2>
      {asWalkthrough && (
        <p>סיור ‎360° עדיין לא צולם כאן. בינתיים אלה התמונות, בסדר שבו עוברים ביחידה. אפשר להחליק, או לנווט עם מקשי החצים.</p>
      )}
    </div>
  </div>

  <div class="wrap gal" data-gallery>
    <div class="gal-viewport" tabindex="0" role="group" aria-roledescription="קרוסלה" aria-label="תמונות הצימר">
      <div class="gal-track">
        {images.map((img, i) => (
          <div class="gal-slide" role="group" aria-roledescription="שקופית" aria-label={`${i + 1} מתוך ${images.length}`}>
            <Figure img={img} ratio="3 / 2" sizes="(min-width: 900px) 46vw, 86vw" widths={[480, 800, 1200]} />
          </div>
        ))}
      </div>
    </div>

    <div class="gal-bar">
      <p class="gal-count" aria-live="polite">
        <span class="sr-only">תמונה</span>
        <span class="ltr num"><span data-gal-current>1</span> / {images.length}</span>
      </p>
      <a class="gal-all" href="/gallery/">לכל התמונות בעמוד מלא</a>
      <div class="gal-nav">
        <button type="button" class="rnd" data-gal-prev aria-label="התמונה הקודמת" disabled>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="rnd" data-gal-next aria-label="התמונה הבאה">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  /* Baseline with no JS at all: a native snap-scroller. Swipe already works. */
  .gal-viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .gal-viewport::-webkit-scrollbar { display: none; }
  .gal[data-embla] .gal-viewport { overflow: hidden; scroll-snap-type: none; }

  /* No padding on the track: Embla measures it in RTL and the first snap drifts. */
  .gal-track { display: flex; gap: var(--s-2); touch-action: pan-y pinch-zoom; }
  .gal-slide { flex: 0 0 86%; scroll-snap-align: start; min-width: 0; }
  @media (min-width: 900px) { .gal-slide { flex-basis: 46%; } }

  .gal-slide :global(.ph) { border-radius: var(--radius-lg); }

  .gal-bar {
    display: flex; align-items: center; justify-content: space-between;
    margin-top: var(--s-3); gap: var(--s-3);
  }
  .gal-count { font-size: var(--t--1); color: var(--muted); }
  .gal-all {
    display: inline-flex; align-items: center; min-height: var(--tap);
    margin-inline-start: auto;
    font-size: var(--t--1); font-weight: 600; color: var(--accent-deep);
    text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--line);
  }
  .gal-all:hover { text-decoration-color: currentColor; }
  .gal-nav { display: flex; gap: var(--s-1); }
  .rnd {
    width: 2.75rem; height: 2.75rem; border-radius: 50%;
    border: 1px solid var(--line); background: transparent;
    display: grid; place-items: center; cursor: pointer;
    transition: border-color 0.2s var(--ease), background-color 0.2s var(--ease);
  }
  .rnd:hover:not(:disabled) { border-color: var(--ink); }
  .rnd:disabled { opacity: 0.3; cursor: default; }
</style>

<script>
  const root = document.querySelector('[data-gallery]');
  if (root) {
    const viewport = root.querySelector('.gal-viewport');
    const slides = [...root.querySelectorAll('.gal-slide')];
    const prev = root.querySelector('[data-gal-prev]');
    const next = root.querySelector('[data-gal-next]');
    const current = root.querySelector('[data-gal-current]');

    const start = async () => {
      const { default: EmblaCarousel } = await import('embla-carousel');
      const embla = EmblaCarousel(viewport, {
        direction: 'rtl',
        align: 'start',
        containScroll: 'trimSnaps',
        skipSnaps: false,
        duration: 22,
      });
      root.setAttribute('data-embla', '');

      const sync = () => {
        const i = embla.selectedScrollSnap();
        current.textContent = String(i + 1);
        prev.disabled = !embla.canScrollPrev();
        next.disabled = !embla.canScrollNext();
      };
      embla.on('select', sync).on('reInit', sync);
      sync();

      prev.addEventListener('click', () => embla.scrollPrev());
      next.addEventListener('click', () => embla.scrollNext());
      viewport.addEventListener('keydown', (e) => {
        // In RTL, ArrowLeft moves forward.
        if (e.key === 'ArrowLeft') { e.preventDefault(); embla.scrollNext(); }
        if (e.key === 'ArrowRight') { e.preventDefault(); embla.scrollPrev(); }
        if (e.key === 'Home') { e.preventDefault(); embla.scrollTo(0); }
        if (e.key === 'End') { e.preventDefault(); embla.scrollTo(slides.length - 1); }
      });
    };

    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 2000 });
    else setTimeout(start, 400);
  }
</script>
