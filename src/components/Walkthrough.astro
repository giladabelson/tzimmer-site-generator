---
import { Image } from 'astro:assets';
const { panoramas = [], splatUrl } = Astro.props;

const mode = panoramas.length ? 'pano' : splatUrl ? 'splat' : null;
if (!mode) throw new Error('Walkthrough rendered without panoramas or a splat URL');

const first = panoramas[0];
const scenes = Object.fromEntries(
  panoramas.map((s) => [
    s.id,
    {
      type: 'equirectangular',
      panorama: s.file.src,
      hfov: s.hfov,
      pitch: s.pitch,
      yaw: s.yaw,
      hotSpots: s.hotspots.map((h) => ({
        pitch: h.pitch,
        yaw: h.yaw,
        type: 'scene',
        sceneId: h.target,
        text: h.text,
        cssClass: 'pnlm-hotspot pnlm-sprite pnlm-scene tz-hot',
      })),
    },
  ]),
);
// Pannellum's own chrome is 26px sprites that miss the 44px touch minimum and
// look nothing like the rest of the page, so we turn it off and draw our own.
const config = {
  firstScene: first?.id,
  scenes,
  autoLoad: true,
  sceneFadeDuration: 650,
  showControls: false,
  showZoomCtrl: false,
  showFullscreenCtrl: false,
};
const anyPlaceholder = panoramas.some((s) => s.source !== 'real');
const titles = Object.fromEntries(panoramas.map((s) => [s.id, s.title]));
---

<section id="tour" aria-labelledby="tour-h" class="sunk">
  <div class="wrap">
    <div class="sec-head" data-sc-in>
      <h2 id="tour-h">{mode === 'pano' ? 'להיכנס פנימה, בלי לנסוע' : 'סריקה תלת־ממדית של היחידה'}</h2>
      <p>
        {mode === 'pano'
          ? 'גררו כדי להסתובב, ולחצו על הנקודות כדי לעבור בין החדרים.'
          : 'סריקה מלאה של החלל. אפשר להסתובב, להתקרב ולזוז בתוכה.'}
      </p>
    </div>
  </div>

  <div class="wrap">
    <div
      class="tour"
      data-tour
      data-mode={mode}
      data-config={mode === 'pano' ? JSON.stringify(config) : undefined}
      data-splat={splatUrl}
      data-titles={mode === 'pano' ? JSON.stringify(titles) : undefined}
      data-sc-in
    >
      <div class="tour-facade" data-facade>
        {mode === 'pano' ? (
          <Image
            src={first.file}
            alt={`תצוגה מקדימה: ${first.title}`}
            widths={[640, 1024, 1600]}
            sizes="(min-width: 900px) 70vw, 100vw"
            loading="lazy"
            decoding="async"
            class="facade-img"
          />
        ) : (
          <div class="facade-img facade-splat" aria-hidden="true"></div>
        )}
        <button type="button" class="tour-play" data-start>
          <span class="tour-play-ring" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
              <path
                d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm0 0c-2.6 0-4.7 4-4.7 9s2.1 9 4.7 9 4.7-4 4.7-9-2.1-9-4.7-9ZM3.3 12h17.4"
                stroke="currentColor"
                stroke-width="1.4"
              />
            </svg>
          </span>
          <span>{mode === 'pano' ? 'להתחיל את הסיור' : 'לטעון את הסריקה'}</span>
          <small>נטען רק בלחיצה, כדי לא לבזבז לכם גלישה</small>
        </button>
        {anyPlaceholder && <span class="badge">תמונת המחשה - טרם צולם</span>}
      </div>

      <div class="tour-stage" dir="ltr" data-stage hidden></div>

      <div class="tour-hud" data-hud hidden>
        <p class="tour-label" data-label aria-live="polite"></p>
        <button type="button" class="tour-fs" data-fs aria-label="הרחבה למסך מלא">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
            <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>

    <noscript>
      <p class="tour-note">הסיור הווירטואלי דורש JavaScript. הגלריה שמתחת פתוחה תמיד.</p>
    </noscript>

    {mode === 'pano' && panoramas.length > 1 && (
      <nav class="rooms" aria-label="חדרים בסיור">
        {panoramas.map((s, i) => (
          <button type="button" class="room" data-scene={s.id} aria-current={i === 0 ? 'true' : 'false'}>
            {s.title}
          </button>
        ))}
      </nav>
    )}

    {mode === 'splat' && (
      <p class="tour-note">הסריקה מתארחת אצל Luma AI ונטענת רק אחרי לחיצה. שאר האתר לא תלוי בה.</p>
    )}

    <a class="tour-gallery" href="/gallery/">לכל התמונות בגודל מלא</a>
  </div>
</section>

<style>
  .tour {
    position: relative;
    aspect-ratio: 16 / 10;
    max-height: 74svh;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--accent-wash);
  }
  @media (min-width: 900px) {
    .tour { aspect-ratio: 16 / 8.4; }
  }

  .tour-facade { position: absolute; inset: 0; display: grid; place-items: center; }
  .tour-facade :global(.facade-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.04) brightness(0.62);
  }
  .facade-splat { background: linear-gradient(135deg, var(--accent-wash), var(--accent-deep)); }

  .tour-play {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    padding: 1.25rem 2rem;
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 0;
    border-radius: var(--radius-lg);
    color: var(--ink);
    font-weight: 600;
    font-size: var(--t-0);
    cursor: pointer;
    transition: transform 0.25s var(--ease), background-color 0.25s var(--ease);
  }
  .tour-play:hover { transform: translateY(-2px); background: #fff; }
  .tour-play small { font-weight: 400; font-size: 0.8rem; color: var(--muted); }
  .tour-play-ring { color: var(--accent-deep); }

  .tour-stage { position: absolute; inset: 0; }
  .tour-stage :global(.pnlm-container) { background: var(--ink) !important; }
  .tour-stage :global(.tz-hot .pnlm-tooltip span) { font-family: var(--font-heb-body); direction: rtl; }

  /* Our own chrome over the viewer, so it matches the page and hits 44px. */
  .tour-hud {
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
    padding: 0.75rem;
    pointer-events: none;
    background: linear-gradient(to top, rgb(12 9 7 / 0.55), transparent);
  }
  .tour-hud[hidden] { display: none; }
  .tour-label {
    color: #fff;
    font-size: var(--t--1);
    font-weight: 600;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.5);
  }
  .tour-fs {
    pointer-events: auto;
    flex: none;
    width: var(--tap);
    height: var(--tap);
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 999px;
    color: #fff;
    background: rgb(23 19 15 / 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    cursor: pointer;
  }
  .tour-fs:hover { background: rgb(23 19 15 / 0.75); }

  .rooms { display: flex; flex-wrap: wrap; gap: var(--s-1); margin-top: var(--s-3); }
  .room {
    min-height: var(--tap);
    padding: 0.5rem 1.15rem;
    border: 1px solid var(--line);
    background: transparent;
    border-radius: 999px;
    font-size: var(--t--1);
    cursor: pointer;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .room[aria-current='true'] { background: var(--accent); color: var(--accent-contrast); border-color: transparent; }
  .tour-note { margin-top: var(--s-2); font-size: var(--t--1); color: var(--muted); }
  .tour-gallery {
    display: inline-flex; align-items: center; min-height: var(--tap);
    margin-top: var(--s-2);
    font-size: var(--t--1); font-weight: 600; color: var(--accent-deep);
    text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--line);
  }
  .tour-gallery:hover { text-decoration-color: currentColor; }
</style>

<script>
  const root = document.querySelector('[data-tour]');
  if (root) {
    const stage = root.querySelector('[data-stage]');
    const facade = root.querySelector('[data-facade]');
    const startBtn = root.querySelector('[data-start]');

    const HE = {
      loadButtonLabel: 'לחצו כדי<br>לטעון את<br>הפנורמה',
      loadingLabel: 'טוען…',
      bylineLabel: 'מאת %s',
      noPanoramaError: 'לא נמצאה תמונת פנורמה.',
      fileAccessError: 'לא ניתן לגשת לקובץ %s.',
      malformedURLError: 'יש בעיה בכתובת הפנורמה.',
      iOS8WebGLError: 'הדפדפן הזה לא תומך בהצגת הפנורמה.',
      genericWebGLError: 'הדפדפן שלכם לא תומך ב-WebGL ולכן אי אפשר להציג את הסיור. הגלריה שמתחת עובדת תמיד.',
      textureSizeError: 'התמונה גדולה מדי למכשיר הזה.',
      unknownError: 'שגיאה לא ידועה בטעינת הסיור.',
    };

    const failGracefully = (msg) => {
      stage.hidden = true;
      facade.hidden = false;
      startBtn.disabled = false;
      if (!root.nextElementSibling?.classList.contains('tour-fail')) {
        const note = document.createElement('p');
        note.className = 'tour-note tour-fail';
        note.setAttribute('role', 'status');
        note.textContent = msg;
        root.after(note);
      }
    };

    const boot = async () => {
      startBtn.disabled = true;
      try {
        if (root.dataset.mode === 'pano') {
          await import('pannellum/build/pannellum.css');
          await import('pannellum/build/pannellum.js');
          if (!window.pannellum) throw new Error('pannellum missing');
          const cfg = JSON.parse(root.dataset.config);
          facade.hidden = true;
          stage.hidden = false;
          const viewer = window.pannellum.viewer(stage, { ...cfg, strings: HE });

          const titles = JSON.parse(root.dataset.titles || '{}');
          const hud = root.querySelector('[data-hud]');
          const label = root.querySelector('[data-label]');
          hud.hidden = false;
          label.textContent = titles[cfg.firstScene] ?? '';
          root.querySelector('[data-fs]').addEventListener('click', () => viewer.toggleFullscreen());

          root.parentElement.querySelectorAll('[data-scene]').forEach((b) => {
            b.addEventListener('click', () => viewer.loadScene(b.dataset.scene));
          });
          viewer.on('scenechange', (id) => {
            label.textContent = titles[id] ?? '';
            root.parentElement.querySelectorAll('[data-scene]').forEach((b) => {
              b.setAttribute('aria-current', String(b.dataset.scene === id));
            });
          });
          viewer.on('error', () => failGracefully(HE.genericWebGLError));
        } else {
          const frame = document.createElement('iframe');
          frame.src = root.dataset.splat;
          frame.title = 'סריקה תלת־ממדית של היחידה';
          frame.loading = 'lazy';
          frame.allow = 'fullscreen';
          frame.style.cssText = 'width:100%;height:100%;border:0';
          stage.appendChild(frame);
          facade.hidden = true;
          stage.hidden = false;
        }
      } catch {
        failGracefully('הסיור הווירטואלי לא נטען. אפשר לראות את כל התמונות בגלריה שמתחת.');
      }
    };

    startBtn.addEventListener('click', boot);
  }
</script>
