---
import { iconPath } from '../lib/icons.mjs';
const { p } = Astro.props;
---

<section id="amenities" aria-labelledby="am-h">
  <div class="wrap">
    <div class="sec-head" data-sc-in>
      <h2 id="am-h">כל מה שצריך, בלי מה שלא</h2>
    </div>

    <ul class="am" data-sc-in data-sc-stagger="55">
      {p.amenities.map((a) => (
        <li>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" width="22" height="22">
            <path d={iconPath(a.icon)} stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>
            {a.label}
            {a.note && <small>{a.note}</small>}
          </span>
        </li>
      ))}
    </ul>

    <!-- Capacity only. Check-in and check-out live in "כללי הבית" further down,
         which is where a guest looks for them, and printing them twice on one
         page made the end of the page read as the same section repeated. -->
    <dl class="facts" data-sc-in data-sc-stagger="45">
      <div><dt>אורחים</dt><dd><span class="num">{p.capacity.guests}</span></dd></div>
      <div><dt>חדרי שינה</dt><dd><span class="num">{p.capacity.bedrooms}</span></dd></div>
      <div><dt>חדרי רחצה</dt><dd><span class="num">{p.capacity.bathrooms}</span></dd></div>
      {p.capacity.beds && <div class="wide"><dt>מיטות</dt><dd class="beds">{p.capacity.beds}</dd></div>}
    </dl>
  </div>
</section>

<style>
  .sec-head { margin-bottom: var(--s-4); }
  .sec-head h2 { font-size: var(--t-2); }

  /* Icon grid - the distinct shape of this section. */
  .am {
    list-style: none; padding: 0;
    display: grid; gap: var(--s-3) var(--s-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
  }
  .am li { display: flex; align-items: flex-start; gap: 0.75rem; }
  .am svg { flex: none; color: var(--accent-deep); margin-top: 0.15em; }
  .am small { display: block; font-size: var(--t--1); color: var(--muted); line-height: 1.55; }

  /* Facts as tiles on card stock, not a hairline table. */
  .facts {
    margin-top: var(--s-5);
    display: grid; gap: var(--s-1);
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
  }
  .facts > div {
    background: var(--paper-card);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-lg);
    padding: var(--s-2) var(--s-2) calc(var(--s-2) + 0.15rem);
    display: flex; flex-direction: column; gap: 0.35rem;
  }
  .facts .wide {
    grid-column: 1 / -1;
    flex-direction: row; align-items: baseline; gap: 0.75rem;
    flex-wrap: wrap;
  }
  dt { font-size: 0.85rem; color: var(--muted); letter-spacing: 0.01em; }
  dd { margin: 0; font-family: var(--font-heb-display); font-size: var(--t-1); line-height: 1.15; color: var(--ink); }
  dd.beds { font-family: var(--font-heb-body); font-size: 1rem; line-height: 1.6; }

  @media (max-width: 767px) {
    .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .facts .wide { grid-column: 1 / -1; }
  }
  @media (max-width: 380px) {
    .facts { grid-template-columns: minmax(0, 1fr); }
  }
</style>
